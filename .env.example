# === SmartAI Assistant — configurare mediu ===
# Copiază acest fișier în .env.local și completează valorile reale.

# --- Inteligență artificială (OBLIGATORIU pentru chat) ---
# Cheia API pentru modelul AI (OpenAI-compatibil). NU o expune în frontend.
OPENAI_API_KEY=sk-your-key-here
# Model folosit (trebuie să suporte imagini pentru vision, ex. gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Endpoint API — permite furnizori OpenAI-compatibili.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Baza de date ---
# LOCAL: lasă gol → se folosește un fișier SQLite în ./data (sau DATA_DIR).
# PRODUCȚIE (Vercel): setează ambele cu datele de la Turso (turso.tech, gratuit).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATA_DIR=./data   # opțional, doar pentru modul local cu fișier

# --- Sesiuni & administrare ---
# Secret pentru semnarea sesiunilor (JWT). Generează un șir lung, aleatoriu.
AUTH_SECRET=schimba-acest-secret-cu-un-sir-lung-si-aleatoriu
# Email-ul care primește automat rol de administrator la înregistrare.
ADMIN_EMAIL=admin@smartai.local
# URL-ul public al aplicației (folosit la redirect-urile OAuth). Opțional în local.
APP_BASE_URL=

# --- Limite de utilizare (mesaje / zi) ---
GUEST_DAILY_LIMIT=5
FREE_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=500

# --- Login cu Google (opțional) ---
# Din Google Cloud Console → OAuth 2.0 Client ID (tip: Web).
# Redirect URI autorizat: <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # opțional, dacă vrei să-l fixezi manual

# --- Login cu Apple (opțional; necesită cont Apple Developer plătit) ---
# Din Apple Developer → Identifiers → Services ID + Key (Sign in with Apple).
# Redirect URI (Return URL): <APP_BASE_URL>/api/auth/apple/callback  (doar HTTPS)
APPLE_SERVICE_ID=          # ex. com.exemplu.smartai.web (client_id)
APPLE_TEAM_ID=             # Team ID (10 caractere)
APPLE_KEY_ID=              # Key ID al cheii .p8
APPLE_PRIVATE_KEY=         # conținutul cheii .p8 (cu \n pentru linii noi)
# APPLE_REDIRECT_URI=      # opțional, dacă vrei să-l fixezi manual
